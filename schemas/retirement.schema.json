{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset retirement decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["retired_on", "decided_by", "policy", "assets"],
  "properties": {
    "retired_on": { "type": "string", "format": "date" },
    "decided_by": { "type": "string", "minLength": 3 },
    "policy": { "type": "string", "minLength": 30 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "provider": { "type": "string", "minLength": 2 },
          "reason": { "type": "string", "minLength": 30 }
        }
      }
    }
  }
}
