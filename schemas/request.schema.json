{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "candidates"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "source",
          "style",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "style": {
            "enum": [
              "realistic",
              "stylized",
              "low-poly"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          },
          "upstream_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "resolution": {
            "enum": [
              "1k",
              "2k",
              "4k"
            ]
          },
          "recipe": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "enum": [
              "light"
            ],
            "description": "Select the decimated light build published inside the base manifest."
          }
        }
      }
    }
  }
}
