{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch", "reason", "requested_at", "candidates"],
  "properties": {
    "revision": {"type": "integer", "minimum": 1},
    "batch": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "reason": {"type": "string", "minLength": 30},
    "requested_at": {"type": "string", "format": "date"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^quarantine/[a-z0-9-]+/[a-z0-9-]+$"}
    }
  }
}
